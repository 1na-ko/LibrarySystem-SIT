# =============================================================================
# Android local.properties 示例（不入 git，仅作模板，实际请复制为 local.properties）
# =============================================================================

# Android SDK 路径（必填，Android Studio 首次打开会自动填充）
#sdk.dir=/path/to/your/Android/Sdk

# -----------------------------------------------------------------------------
# 后端 API 配置（P0-02 HTTPS 半改造）
# -----------------------------------------------------------------------------
# 模式 1：默认连生产 HTTP（端口 8080）— 用于真机调试与日常开发
#   保持下方两行注释或不设置即可（构建脚本默认行为）。
#
# 模式 2：连模拟器宿主机后端（端口 8080）— 用于本地后端联调
#api.base.url=http://10.0.2.2:8080/api/v1/
#
# 模式 3：连本机后端（真机 USB 连同一局域网）
#api.base.url=http://192.168.x.x:8080/api/v1/
#
# 模式 4：连生产 HTTPS（端口 8443）— 等后端证书就绪后启用
#api.use.https=true
#   ▸ 启用 HTTPS 后默认 BASE_URL 自动切换为 https://101.132.24.73:8443/api/v1/
#   ▸ Release 构建会触发 verifyReleaseHttps 自动校验，HTTPS 是 Release 强制要求
#   ▸ 同时务必删除 res/xml/network_security_config.xml 中的 101.132.24.73 cleartext 域名
#
# 模式 5：完全自定义 BASE_URL（覆盖以上所有规则）
#api.base.url=https://your.custom.host/api/v1/

# -----------------------------------------------------------------------------
# Mock 模式（P0-05 仅 Debug 构建生效）
# -----------------------------------------------------------------------------
# 设为 true 后，Debug 构建中 MockInterceptor 会拦截所有 API 返回模拟数据.
# Release 构建即使设为 true 也不生效（MockInterceptor 不会被注入到 OkHttpClient）.
#mock.enabled=false

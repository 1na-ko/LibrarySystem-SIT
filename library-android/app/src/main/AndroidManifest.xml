<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 相机权限（条码扫描） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".LibraryApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LibrarySystem"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <!-- 启动页 -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 图书编目（WP3.2：深色主题通过 XML 静态声明，不再硬编码 Java） -->
        <activity
            android:name=".ui.admin.BookEditActivity"
            android:exported="false"
            android:label="@string/add_book_title"
            android:parentActivityName=".ui.main.MainActivity"
            android:theme="@style/Theme.LibrarySystem.Dark" />

        <!-- 条码扫描 -->
        <activity
            android:name=".ui.scanner.ScanBarcodeActivity"
            android:exported="false"
            android:label="扫码"
            android:theme="@style/Theme.LibrarySystem.Scan" />

        <!-- WP-14：独立搜索 Activity（无主 header/无 BottomNav） -->
        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false"
            android:label="@string/search" />

    </application>
</manifest>

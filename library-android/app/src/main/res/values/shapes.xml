<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         Design Tokens v2.1 — 圆角 ShapeAppearance 定义
         全局硬上限：4dp（border-radius ≤ 4dp）
         ============================================================ -->

    <!-- 无圆角（搜索栏、输入框、底部导航） -->
    <style name="ShapeAppearance.Library.None" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <!-- 小圆角 2dp（FilterTab、Chip、状态指示器） -->
    <style name="ShapeAppearance.Library.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>

    <!-- 中圆角 4dp（所有卡片，硬上限） -->
    <style name="ShapeAppearance.Library.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_md</item>
    </style>

    <!-- 顶部圆角 4dp（底部弹窗） -->
    <style name="ShapeAppearance.Library.TopRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_md</item>
        <item name="cornerSizeTopRight">@dimen/radius_md</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         Design Tokens v2.1 — 图书馆智能管理系统配色
         浅色模式为默认；深色模式通过 Theme.LibrarySystem.Dark 应用
         ============================================================ -->

    <!-- ── 背景（浅色） ── -->
    <color name="bg_primary">#F7F4EB</color>
    <color name="bg_card">#FDFCF8</color>
    <color name="bg_input">#FFFFFF</color>
    <color name="bg_overview">#F8F6F1</color>

    <!-- ── 文字（浅色） ── -->
    <color name="text_primary">#2A3B32</color>
    <color name="text_secondary">#666666</color>
    <color name="text_tertiary">#999999</color>
    <color name="text_placeholder">#B0B0B0</color>

    <!-- ── 功能色 ── -->
    <color name="accent_cta">#8B3A3A</color>
    <color name="accent_available">#4A7C59</color>
    <color name="accent_checkedout">#D1D1D1</color>
    <color name="accent_reserve">#D4A24C</color>

    <!-- ── 边框（浅色） ── -->

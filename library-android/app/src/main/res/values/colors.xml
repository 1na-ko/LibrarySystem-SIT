    <!-- ── 深色模式 背景 ── -->
    <color name="dark_bg_primary">#1A1A1A</color>
    <color name="dark_bg_card">#2C2C2E</color>
    <color name="dark_bg_input">#2C2C2E</color>
    <color name="dark_bg_overview">#2C2C2E</color>

    <!-- ── 深色模式 文字 ── -->
    <color name="dark_text_primary">#F5F5F5</color>
    <color name="dark_text_secondary">#A0A0A0</color>
    <color name="dark_text_tertiary">#707070</color>
    <color name="dark_text_placeholder">#555555</color>

    <!-- ── 深色模式 边框 ── -->
    <color name="dark_border_light">#3A3A3C</color>

    <!-- ── 知识图谱专用色（深色背景下） ── -->
    <color name="kg_node_core">#1A3A5C</color>
    <color name="kg_node_secondary">#4A6B8A</color>

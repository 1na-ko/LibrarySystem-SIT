<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/searchFragment">

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.library.android.ui.search.SearchFragment"
        android:label="搜索" />

    <fragment
        android:id="@+id/borrowFragment"
        android:name="com.library.android.ui.borrow.BorrowFragment"
        android:label="借阅" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.library.android.ui.profile.ProfileFragment"
        android:label="我的" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.library.android.ui.login.LoginFragment"
        android:label="登录">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.library.android.ui.login.RegisterFragment"
        android:label="注册" />
</navigation>
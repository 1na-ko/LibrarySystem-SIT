<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- 控制面板 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_sm"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/direction_label"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <Spinner
            android:id="@+id/spinnerDirection"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_min_height"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/space_sm"
            android:entries="@array/trace_directions"
            android:textColor="?attr/colorOnSurface"
            android:backgroundTint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/max_depth_label"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <Spinner
            android:id="@+id/spinnerDepth"
            android:layout_width="@dimen/book_item_min_height"
            android:layout_height="@dimen/button_min_height"
            android:layout_marginStart="@dimen/space_sm"
            android:entries="@array/trace_depths"
            android:textColor="?attr/colorOnSurface"
            android:backgroundTint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/layoutLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="visible">

            <ProgressBar
                style="?android:attr/progressBarStyle"
                android:layout_width="32dp"
                android:layout_height="32dp" />

            <TextView
                android:id="@+id/textLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/loading_text"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_size_body_large" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>

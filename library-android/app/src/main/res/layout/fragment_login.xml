<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:gravity="center"
    android:padding="@dimen/space_xxl">

    <!-- ================================================================
         Login Card
         ================================================================ -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Library.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title -->
            <TextView
                style="@style/TextAppearance.Library.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="图书馆管理系统"
                android:gravity="center"
                android:layout_marginBottom="@dimen/space_sm" />

            <!-- Subtitle -->
            <TextView
                style="@style/TextAppearance.Library.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="学术 · 严谨 · 知识"
                android:gravity="center"
                android:layout_marginBottom="@dimen/space_xxl" />

            <!-- Username field -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Library.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="学号/工号"
                android:layout_marginBottom="@dimen/space_lg">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password field -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Library.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="密码"
                app:passwordToggleEnabled="true"
                android:layout_marginBottom="@dimen/space_xl">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Login button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                style="@style/Widget.Library.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="登录" />

            <!-- Register link -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                style="@style/Widget.Library.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="还没有账号？立即注册"
                android:textColor="@color/text_tertiary"
                android:layout_marginTop="@dimen/space_sm" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>

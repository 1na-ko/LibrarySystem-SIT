<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <!-- ================================================================
             User Info Card
             ================================================================ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUserInfo"
            style="@style/Widget.Library.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/space_lg">

                <!-- Avatar placeholder：品牌色圆形背景，优先显示姓名首字母，无姓名时显示默认用户图标 -->
                <FrameLayout
                    android:id="@+id/ivAvatar"
                    android:layout_width="@dimen/space_xxxl"
                    android:layout_height="@dimen/space_xxxl"
                    android:background="@drawable/bg_avatar_circle"
                    android:contentDescription="@string/avatar_content_description">

                    <TextView
                        android:id="@+id/tvAvatarInitials"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_title_large"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="张" />

                    <ImageView
                        android:id="@+id/ivAvatarDefault"
                        android:layout_width="@dimen/icon_size_lg"
                        android:layout_height="@dimen/icon_size_lg"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_avatar_default"
                        android:contentDescription="@null"
                        app:tint="@color/white" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/space_md"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvLoginStatus"
                        style="@style/TextAppearance.Library.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="" />

                    <TextView
                        android:id="@+id/tvUsername"
                        style="@style/TextAppearance.Library.BodySecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvRole"
                        style="@style/TextAppearance.Library.BodySecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvRealName"
                        style="@style/TextAppearance.Library.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvEmail"
                        style="@style/TextAppearance.Library.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================================
             Borrow Overview Row — three stat cards equally weighted
             ================================================================ -->
        <LinearLayout
            android:id="@+id/layoutBorrowOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_lg"
            android:visibility="gone">

            <!-- Card 1: Current Borrows -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCurrentBorrows"
                style="@style/Widget.Library.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvCurrentBorrows"
                        style="@style/TextAppearance.Library.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_available"
                        android:gravity="center"
                        tools:text="0" />

                    <TextView
                        style="@style/TextAppearance.Library.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_current_borrows"
                        android:gravity="center" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Total Borrows -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTotalBorrows"
                style="@style/Widget.Library.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginEnd="@dimen/space_xs">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvHistoryCount"
                        style="@style/TextAppearance.Library.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:gravity="center"
                        tools:text="0" />

                    <TextView
                        style="@style/TextAppearance.Library.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_total_borrows"
                        android:gravity="center" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Overdue -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOverdue"
                style="@style/Widget.Library.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvOverdueCount"
                        style="@style/TextAppearance.Library.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_cta"
                        android:gravity="center"
                        tools:text="0" />

                    <TextView
                        style="@style/TextAppearance.Library.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/overdue_label"
                        android:gravity="center" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ================================================================
             Function Entry List — flat clickable rows (no MaterialCardView)
             ================================================================ -->
        <LinearLayout
            android:id="@+id/layoutFunctionEntries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/bg_card"
            android:visibility="gone">

            <!-- Row 1: 借阅历史 -->
            <LinearLayout
                android:id="@+id/layoutBorrowHistory"
                android:layout_width="match_parent"
                android:layout_height="@dimen/list_item_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_lg"
                android:paddingEnd="@dimen/space_lg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:background="@color/bg_card">

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@drawable/ic_nav_borrow"
                    android:contentDescription="@string/borrow_history"
                    app:tint="@color/accent_available" />

                <TextView
                    style="@style/TextAppearance.Library.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="@string/borrow_history" />

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="@null"
                    app:tint="@color/text_tertiary" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_thickness"
                android:background="@color/border_light"
                android:layout_marginStart="@dimen/list_item_height" />

            <!-- Row 2: 借阅统计 -->
            <LinearLayout
                android:id="@+id/layoutBorrowStats"
                android:layout_width="match_parent"
                android:layout_height="@dimen/list_item_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_lg"
                android:paddingEnd="@dimen/space_lg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:background="@color/bg_card">

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@drawable/ic_nav_search"
                    android:contentDescription="@string/borrow_stats"
                    app:tint="@color/accent_available" />

                <TextView
                    style="@style/TextAppearance.Library.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="@string/borrow_stats" />

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="@null"
                    app:tint="@color/text_tertiary" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_thickness"
                android:background="@color/border_light"
                android:layout_marginStart="@dimen/list_item_height" />

            <!-- Row 3: 编辑资料 -->
            <LinearLayout
                android:id="@+id/layoutEditProfile"
                android:layout_width="match_parent"
                android:layout_height="@dimen/list_item_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_lg"
                android:paddingEnd="@dimen/space_lg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:background="@color/bg_card">

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@drawable/ic_nav_profile"
                    android:contentDescription="@string/edit_profile"
                    app:tint="@color/accent_cta" />

                <TextView
                    style="@style/TextAppearance.Library.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="@string/edit_profile" />

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="@null"
                    app:tint="@color/text_tertiary" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_thickness"
                android:background="@color/border_light"
                android:layout_marginStart="@dimen/list_item_height" />

            <!-- Row 5: 我的预约 -->
            <LinearLayout
                android:id="@+id/layoutReservations"
                android:layout_width="match_parent"
                android:layout_height="@dimen/list_item_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_lg"
                android:paddingEnd="@dimen/space_lg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:background="@color/bg_card">

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@drawable/ic_book_placeholder"
                    android:contentDescription="@string/profile_my_reservations"
                    app:tint="@color/accent_reserve" />

                <TextView
                    style="@style/TextAppearance.Library.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="@string/profile_my_reservations" />

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="@null"
                    app:tint="@color/text_tertiary" />

            </LinearLayout>

        </LinearLayout>

        <!-- ================================================================
             Admin / Acquisitor 入口（C.4 新增，登录用户角色满足时显示）
             ================================================================ -->
        <LinearLayout
            android:id="@+id/layoutAdminSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_lg"
            android:visibility="gone"
            android:background="@color/bg_card">

            <TextView
                style="@style/TextAppearance.Library.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_md"
                android:text="@string/profile_admin_tools"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:id="@+id/layoutDashboard"
                android:layout_width="match_parent"
                android:layout_height="@dimen/list_item_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_lg"
                android:paddingEnd="@dimen/space_lg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@drawable/ic_nav_home"
                    android:contentDescription="@string/dashboard_title"
                    app:tint="@color/text_secondary" />
                <TextView
                    style="@style/TextAppearance.Library.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="@string/dashboard_title" />
                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="@null"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutAdminUsers"
                android:layout_width="match_parent"
                android:layout_height="@dimen/list_item_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_lg"
                android:paddingEnd="@dimen/space_lg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@drawable/ic_nav_profile"
                    android:contentDescription="@string/profile_user_mgmt"
                    app:tint="@color/text_secondary" />
                <TextView
                    style="@style/TextAppearance.Library.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="@string/profile_user_mgmt" />
                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="@null"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <!-- WP1.7：超期管理入口（管理员/Librarian 可见） -->
            <LinearLayout
                android:id="@+id/layoutOverdueMgmt"
                android:layout_width="match_parent"
                android:layout_height="@dimen/list_item_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_lg"
                android:paddingEnd="@dimen/space_lg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@drawable/ic_nav_borrow"
                    android:contentDescription="@string/profile_overdue_mgmt"
                    app:tint="@color/accent_cta" />

                <TextView
                    style="@style/TextAppearance.Library.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="@string/profile_overdue_mgmt" />

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="@null"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutAcquisition"
                android:layout_width="match_parent"
                android:layout_height="@dimen/list_item_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_lg"
                android:paddingEnd="@dimen/space_lg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@drawable/ic_book_placeholder"
                    android:contentDescription="@string/acquisition_title"
                    app:tint="@color/accent_cta" />

                <TextView
                    style="@style/TextAppearance.Library.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="@string/acquisition_title" />

                <ImageView
                    android:layout_width="@dimen/icon_size_md"
                    android:layout_height="@dimen/icon_size_md"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="@null"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================================================================
             Action Buttons
             ================================================================ -->

        <!-- Login button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/Widget.Library.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_login_btn"
            android:layout_marginTop="@dimen/space_xl"
            android:visibility="gone" />

        <!-- Logout button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.Library.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/logout"
            android:textColor="@color/text_tertiary"
            android:layout_marginTop="@dimen/space_md"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <!-- 图书封面：使用品牌化占位图 -->
            <ImageView
                android:id="@+id/ivCover"
                android:layout_width="@dimen/detail_cover_width"
                android:layout_height="@dimen/detail_cover_height"
                android:layout_gravity="center"
                android:background="@color/bg_overview"
                android:src="@drawable/ic_book_placeholder_branded"
                android:scaleType="centerCrop"
                android:contentDescription="@string/book_cover" />

            <!-- 书名 -->
            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextAppearance.Library.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg" />

            <!-- 作者 -->
            <TextView
                android:id="@+id/tvAuthor"
                style="@style/TextAppearance.Library.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm" />

            <!-- 出版社 + 出版日期 -->
            <TextView
                android:id="@+id/tvPublisher"
                style="@style/TextAppearance.Library.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs" />

            <!-- 图书信息卡片 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Library.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <TextView
                        android:id="@+id/tvIsbn"
                        style="@style/TextAppearance.Library.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_sm" />

                    <TextView
                        android:id="@+id/tvCategory"
                        style="@style/TextAppearance.Library.BodySecondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_xs" />

                    <TextView
                        android:id="@+id/tvLocation"
                        style="@style/TextAppearance.Library.BodySecondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_xs" />

                    <TextView
                        android:id="@+id/tvPubDate"
                        style="@style/TextAppearance.Library.BodySecondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_sm" />

                    <!-- 分割线 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stroke_thickness"
                        android:background="@color/border_light"
                        android:layout_marginTop="@dimen/space_sm"
                        android:layout_marginBottom="@dimen/space_sm" />

                    <!-- 借阅信息行 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvAvailCopies"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="@dimen/text_size_title"
                            android:textStyle="bold"
                            android:textColor="@color/accent_available" />

                        <TextView
                            android:id="@+id/tvReservationCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_body_small"
                            android:textColor="@color/text_tertiary" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 操作按钮组：统一间距 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBorrow"
                style="@style/Widget.Library.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/borrow_this_book"
                android:layout_marginTop="@dimen/space_lg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReserve"
                style="@style/Widget.Library.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reserve_this_book"
                android:visibility="gone"
                android:layout_marginTop="@dimen/space_md" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKnowledgeGraph"
                style="@style/Widget.Library.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_knowledge_graph"
                android:layout_marginTop="@dimen/space_md" />

            <!-- 图书简介区块标题 -->
            <TextView
                style="@style/TextAppearance.Library.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_description"
                android:layout_marginTop="@dimen/space_xl" />

            <!-- 图书简介内容 -->
            <TextView
                android:id="@+id/tvDescription"
                style="@style/TextAppearance.Library.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:lineSpacingExtra="@dimen/space_xs" />

            <!-- 关键词区块标题 -->
            <TextView
                style="@style/TextAppearance.Library.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_keywords"
                android:layout_marginTop="@dimen/space_xl" />

            <!-- 关键词标签组 -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupKeywords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:singleLine="false" />

            <!-- 相关推荐区块标题 -->
            <TextView
                style="@style/TextAppearance.Library.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_related_books"
                android:layout_marginTop="@dimen/space_xl" />

            <!-- 相关推荐列表 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRelatedBooks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="@dimen/space_sm" />

        </LinearLayout>

    </ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 图书封面 -->
            <ImageView
                android:id="@+id/ivCover"
                android:layout_width="@dimen/detail_cover_width"
                android:layout_height="@dimen/detail_cover_height"
                android:layout_gravity="center"
                android:background="@color/bg_overview"
                android:scaleType="centerCrop"
                android:contentDescription="@string/book_cover" />

            <!-- 书名 -->
            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextAppearance.Library.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <!-- 作者 -->
            <TextView
                android:id="@+id/tvAuthor"
                style="@style/TextAppearance.Library.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- 出版社 + 出版日期 -->
            <TextView
                android:id="@+id/tvPublisher"
                style="@style/TextAppearance.Library.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <!-- 图书信息卡片 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Library.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvIsbn"
                        style="@style/TextAppearance.Library.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvCategory"
                        style="@style/TextAppearance.Library.BodySecondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvLocation"
                        style="@style/TextAppearance.Library.BodySecondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvPubDate"
                        style="@style/TextAppearance.Library.BodySecondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" />

                    <!-- 分割线 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_light"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <!-- 借阅信息行 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvAvailCopies"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_available" />

                        <TextView
                            android:id="@+id/tvReservationCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/text_tertiary" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 借阅按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBorrow"
                style="@style/Widget.Library.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="借阅此书"
                android:layout_marginTop="16dp" />

            <!-- 预约按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReserve"
                style="@style/Widget.Library.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="预约此书"
                android:visibility="gone"
                android:layout_marginTop="8dp" />

            <!-- 图书简介区块标题 -->
            <TextView
                style="@style/TextAppearance.Library.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="图书简介"
                android:layout_marginTop="24dp" />

            <!-- 图书简介内容 -->
            <TextView
                android:id="@+id/tvDescription"
                style="@style/TextAppearance.Library.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp" />

            <!-- 关键词区块标题 -->
            <TextView
                style="@style/TextAppearance.Library.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="关键词"
                android:layout_marginTop="20dp" />

            <!-- 关键词标签组 -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupKeywords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleLine="false" />

            <!-- 相关推荐区块标题 -->
            <TextView
                style="@style/TextAppearance.Library.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="相关推荐"
                android:layout_marginTop="20dp" />

            <!-- 相关推荐列表 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRelatedBooks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/depth_label"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@color/dark_text_secondary" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderDepth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="12dp"
            android:valueFrom="1"
            android:valueTo="3"
            android:stepSize="1"
            android:value="2"
            app:trackColorActive="@color/kg_node_core"
            app:thumbColor="@color/kg_node_core" />

        <TextView
            android:id="@+id/textDepthValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/dark_text_primary" />

    </LinearLayout>

    <!-- WP1.1：KG 子页面导航 ChipGroup（文献溯源 / 学科网络 / 实体搜索） -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupKgSubPages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        app:singleSelection="true"
        app:chipSpacingHorizontal="8dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLiteratureTrace"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kg_tab_trace"
            android:textColor="@color/dark_text_secondary"
            app:chipBackgroundColor="@color/dark_chip_bg"
            app:chipStrokeColor="@color/dark_text_placeholder"
            app:chipStrokeWidth="1dp"
            app:checkedIconEnabled="false" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSubjectNetwork"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kg_tab_subject"
            android:textColor="@color/dark_text_secondary"
            app:chipBackgroundColor="@color/dark_chip_bg"
            app:chipStrokeColor="@color/dark_text_placeholder"
            app:chipStrokeWidth="1dp"
            app:checkedIconEnabled="false" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipEntitySearch"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kg_tab_entity"
            android:textColor="@color/dark_text_secondary"
            app:chipBackgroundColor="@color/dark_chip_bg"
            app:chipStrokeColor="@color/dark_text_placeholder"
            app:chipStrokeWidth="1dp"
            app:checkedIconEnabled="false" />

    </com.google.android.material.chip.ChipGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark_bg_primary">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/textLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/loading_text"
            android:textColor="@color/dark_text_placeholder"
            android:textSize="15sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>

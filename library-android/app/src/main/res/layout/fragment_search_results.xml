<?xml version="1.0" encoding="utf-8"?>
<!-- WP-14：搜索结果独立页面（独立于搜索首页，有自己的 toolbar + 结果列表） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <include layout="@layout/page_toolbar" />

    <LinearLayout
        android:id="@+id/layoutResultHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="@dimen/space_md"
        android:background="@color/bg_card">

        <TextView
            android:id="@+id/tvResultInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/text_size_body_small"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/textLoading"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/loading_text"
        android:textColor="@color/text_placeholder"
        android:textSize="@dimen/text_size_body_large"
        android:visibility="gone" />

    <TextView
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:visibility="gone"
        android:drawablePadding="@dimen/space_md"
        app:drawableTopCompat="@drawable/ill_empty_state"
        android:text="@string/search_no_results"
        android:textSize="@dimen/text_size_body_large"
        android:textColor="@color/text_tertiary" />

</LinearLayout>

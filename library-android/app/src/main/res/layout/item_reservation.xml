<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_xs"
    style="@style/Widget.Library.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <!-- Row 1: Book title + status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvBookTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/TextAppearance.Library.Title"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="深入理解Java虚拟机" />

            <View
                android:id="@+id/statusDot"
                android:layout_width="@dimen/timeline_dot_size"
                android:layout_height="@dimen/timeline_dot_size"
                android:layout_marginEnd="6dp"
                android:background="@drawable/circle_dot" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.Library.Label"
                tools:text="等待中" />

        </LinearLayout>

        <!-- Row 2: Author -->
        <TextView
            android:id="@+id/tvAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            style="@style/TextAppearance.Library.BodySecondary"
            tools:text="周志明" />

        <!-- Row 3: Queue position, Reserve time, Expire time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvQueuePosition"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/TextAppearance.Library.Caption"
                tools:text="排队第3位" />

            <TextView
                android:id="@+id/tvReserveTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.Library.Caption"
                tools:text="预约: 2026-06-10" />

            <TextView
                android:id="@+id/tvExpireTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                style="@style/TextAppearance.Library.Caption"
                tools:text="过期: 2026-06-15" />

        </LinearLayout>

        <!-- WP-8 P0：取消预约按钮（WAITING/NOTIFIED 状态可见）— 朱砂红描边 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/cancel_reservation"
            android:textColor="@color/accent_cta"
            android:clickable="true"
            android:focusable="true"
            app:strokeColor="@color/accent_cta"
            app:strokeWidth="1dp"
            app:rippleColor="@color/accent_cta"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

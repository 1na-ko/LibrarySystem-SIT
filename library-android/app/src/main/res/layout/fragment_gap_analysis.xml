<?xml version="1.0" encoding="utf-8"?>
<!-- WP-11：缺口分析结构化 UI（覆盖率进度条 + 缺口图书卡片列表，原纯文本） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical"
    android:padding="@dimen/space_lg">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputSubjectId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/acquisition_subject_id_hint"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/etSubjectId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text|textNoSuggestions" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRun"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:text="@string/acquisition_run" />

    <!-- 概览卡片：核心书数 / 已馆藏 / 覆盖率进度条 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardOverview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:visibility="gone"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeWidth="@dimen/stroke_thickness"
        app:strokeColor="@color/border_light"
        app:cardBackgroundColor="@color/bg_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvSubjectName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body_large"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOwned"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/text_size_body_small"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_body_small"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressCoverage"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_sm"
                android:layout_marginTop="6dp"
                android:max="100" />

            <TextView
                android:id="@+id/tvCoverage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:textSize="@dimen/text_size_md"
                android:textColor="@color/accent_cta" />

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="@dimen/text_size_md"
                android:textColor="@color/text_tertiary"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvGapHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/acquisition_gap_books"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_body"
        android:textStyle="bold"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGapBooks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_lg" />

    <TextView
        android:id="@+id/tvResultHint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/acquisition_gap_hint"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_size_body"
        android:visibility="visible" />
</LinearLayout>

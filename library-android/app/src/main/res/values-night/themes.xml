<?xml version="1.0" encoding="utf-8"?>
<!--
  WP-14：系统深色模式下的主题覆盖。
  继承 Theme.LibrarySystem.Base（定义在 values/themes.xml），
  仅覆盖必须在夜间反转的开关类属性；颜色 Token 已由 values-night/colors.xml 覆盖。
-->
<resources>
    <style name="Theme.LibrarySystem" parent="Theme.LibrarySystem.Base">
        <item name="android:statusBarColor">@color/bg_card</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>

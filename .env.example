# =============================================================================
# 图书馆智能管理系统 — 环境变量模板
# 复制此文件为 .env 并填入实际值（.env 已加入 .gitignore）
# =============================================================================

# ---- 数据库 ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=library_db
DB_USERNAME=root
DB_PASSWORD=root123456

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123456

# ---- Elasticsearch ----
ES_HOST=localhost
ES_PORT=9200

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j123456

# ---- RabbitMQ ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ---- JWT ----
# HS256 要求密钥 >= 32 字节（启动时 fail-fast 校验，不满足则拒绝启动）
# 生成方式: openssl rand -base64 48
JWT_SECRET=

# ---- LLM & Embedding ----
# DeepSeek API: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里云百炼 Embedding: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# ---- 日志 ----
LOG_LEVEL=DEBUG

# ---- 服务端口 ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

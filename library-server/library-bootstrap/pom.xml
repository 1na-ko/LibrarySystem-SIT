<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.library</groupId>
        <artifactId>library-server</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>library-bootstrap</artifactId>
    <description>启动聚合模块 — Spring Boot 入口、全局配置、Flyway 数据库迁移</description>

    <dependencies>
        <dependency>
            <groupId>com.library</groupId>
            <artifactId>library-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.library</groupId>
            <artifactId>library-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.library</groupId>
            <artifactId>library-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.library</groupId>
            <artifactId>library-knowledge-graph</artifactId>
        </dependency>
        <dependency>
            <groupId>com.library</groupId>
            <artifactId>library-acquisition</artifactId>
        </dependency>
        <dependency>
            <groupId>com.library</groupId>
            <artifactId>library-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- RabbitMQ：阶段10 事件总线。RabbitMqConfig 声明 Exchange/Queue/死信/Converter/RetryTemplate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- 生成 IDE 元数据以支持自定义配置键（jwt.* 等）的自动补全 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- JaCoCo 聚合覆盖率报告：library-bootstrap 依赖全部业务模块（compile scope），
                 report-aggregate 在 verify 阶段收集各模块 target/jacoco.exec 生成聚合报告，
                 输出 target/site/jacoco-aggregate/index.html（对照 Makefile coverage 目标提示路径）。
                 父 POM pluginManagement 已配 prepare-agent + 单模块 report + excludes（排除 config/entity/dto/mapper/Application）。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
